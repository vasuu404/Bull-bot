# Discord Developer Portal se copy karo (Bot tab -> Reset Token)
BOT_TOKEN=your_bot_token_here

# Same Developer Portal page pe "Application ID" milega (General Information tab)
APPLICATION_ID=your_application_id_here

# Discord app pe right-click "Copy Server ID" karke yahan paste karo
GUILD_ID=your_server_id_here

# Har role ka ID (Server Settings -> Roles -> role pe right click -> Copy ID)
MEMBER_ROLE_ID=
VERIFIED_ROLE_ID=
MODERATOR_ROLE_ID=
ADMIN_ROLE_ID=

# Har channel ka ID (channel pe right click -> Copy ID)
WELCOME_CHANNEL_ID=
VERIFICATION_CHANNEL_ID=
ANNOUNCEMENTS_CHANNEL_ID=
SUPPORT_TICKET_CHANNEL_ID=
GIVEAWAYS_CHANNEL_ID=
INVITES_CHANNEL_ID=

# NEW: Rules channel — new members get auto-tagged here right after they verify
RULES_CHANNEL_ID=

# Ticket channels is category ke andar banenge
TICKET_CATEGORY_ID=

# Forex/trading news auto-post channel + interval (minutes) — default 10
NEWS_CHANNEL_ID=
NEWS_INTERVAL_MINUTES=10

# Optional: change the RSS feed news is pulled from (default: ForexLive)
NEWS_RSS_URL=https://www.forexlive.com/feed/news

# NEW: Economic calendar auto-post channel — posts once every week automatically
ECONOMIC_CALENDAR_CHANNEL_ID=
